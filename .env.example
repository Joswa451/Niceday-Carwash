# Copy to .env for local development. Never commit real credentials.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Supabase connection string. Prefer the "Connection pooling" URI (port 6543).
# The app adds sslmode=require automatically for hosted databases.
# URL-encode special characters in your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: creates the initial admin when the accounts table has no admin.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=choose-a-strong-password
# DEFAULT_ADMIN_EMAIL=admin@nicedaycarwash.local

# Optional app settings
# APP_TIMEZONE=Asia/Manila
# SESSION_COOKIE_SECURE=false
# UPLOAD_FOLDER=frontend/public/static/uploads
