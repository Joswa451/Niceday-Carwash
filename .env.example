# Copy to .env for local development. Never commit real credentials.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Supabase connection string. Prefer the "Connection pooling" URI (port 6543).
# The app adds sslmode=require automatically for hosted databases.
# URL-encode special characters in your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Required for a fresh database: creates the initial admin when no admin exists.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
# DEFAULT_ADMIN_EMAIL=admin@nicedaycarwash.local

# Optional app settings
# APP_TIMEZONE=Asia/Manila
# SESSION_COOKIE_SECURE=false
# UPLOAD_FOLDER=frontend/public/static/uploads
# Comma-separated frontend origins allowed to call the JSON API.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
